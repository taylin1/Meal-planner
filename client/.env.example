[TEMPLATE]
# Copy this file to client/.env and fill in real values:
#   cp client/.env.example client/.env
#
# client/.env is gitignored — never commit real credentials.
# Vite only exposes variables prefixed with VITE_ to the browser bundle,
# and every VITE_ value is PUBLIC once built. Never put the Supabase
# service role key or Edamam credentials here.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Origin of the Express API (the server, not the client).
# Unset falls back to http://localhost:3001.
VITE_API_URL=http://localhost:3001

# Hide the Qvac question/answer bar. Set to "true" to free dashboard space.
# When "true", QuestionBar and DisplayAnswer are not rendered.# Set via Render environment variables (VITE_HIDE_QVAC=true) or local .env.
VITE_HIDE_QVAC=false