# Copy this file to server/.env and fill in real values:
#   cp server/.env.example server/.env
#
# server/.env is gitignored — never commit real credentials.

PORT=3001

# Supabase → Project Settings → API
SUPABASE_URL=
# Service role key. Bypasses Row Level Security, so the server has full admin
# access to the database. Server-side only — never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Edamam → developer.edamam.com → Applications
EDAMAM_APP_ID=
EDAMAM_APP_KEY=

# Origin the API accepts browser requests from.
# This must be the CLIENT origin, not the server's own port.
CLIENT_URL=http://localhost:5173
